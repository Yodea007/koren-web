# PostgreSQL connection string
DATABASE_URI=postgresql://user:password@127.0.0.1:5432/your-database-name

# For a hosted database requiring TLS (e.g. Neon), append ?sslmode=require
#DATABASE_URI=postgresql://user:password@host:5432/your-database-name?sslmode=require

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Stripe (mode Test : sk_test_… / pk_test_… ; mode Live : sk_live_…)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
# Secret de l'endpoint webhook (dashboard Stripe → Webhooks, ou `stripe listen` en local)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# E-mails transactionnels (SMTP Gmail) — sans ces deux variables, aucun e-mail ne part
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Koren France
# Copie maison des commandes (défaut : e.alhadef@gmail.com)
COMMANDES_EMAIL=
